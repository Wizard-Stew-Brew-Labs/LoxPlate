<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8632</NoWarn>
    <AssemblyName>LoxPlate.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

  <!-- The damage-routing math is Unity-free: the tested source is the
       shipped source, compiled straight into the test assembly. -->
  <ItemGroup>
    <Compile Include="../../src/BardingMath.cs" Link="Shipped/BardingMath.cs" />
  </ItemGroup>

</Project>
